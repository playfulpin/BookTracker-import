# =============================================================================
# booktracker-import — environment template
#
# Copy this file to `.env` (gitignored) and fill in real values:
#     cp .env.example .env
#
# Everything here is optional; the same variables can be exported directly
# in your shell.  Values here override the defaults in config/config.sh.
# =============================================================================

# --- Credentials (required for downloading .torrent files) ------------------
BOOKTRACKER_USERNAME=mpolyakov
BOOKTRACKER_PASSWORD=AMw52O0Y

# --- Optional overrides -----------------------------------------------------
# BOOKTRACKER_BASE_URL=https://booktracker.org
# DATA_DIR=/path/to/data
# LOG_DIR=/path/to/logs
# LOG_LEVEL=info            # debug | info | warn | error
# MONTH_OFFSET=1            # monthly archives: 1 = previous month
# DRY_RUN=0                 # 1 = do not download, only print actions

# --- Torrent naming & retention ---------------------------------------------
# TORRENT_NAME_PREFIX=flibusta   # file name prefix
# ARCHIVE_DIR=/path/to/archive   # where superseded torrents are moved
# ARCHIVE_TORRENTS=1             # 1 = archive superseded, 0 = delete them
# TORRENT_RETENTION_DAYS=0       # prune archive older than N days (0 = keep)
# STATE_FILE=/path/to/downloads.tsv   # download state/history log
